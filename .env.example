# 复制为 .env 并填入真实值（.env 已在 .gitignore 中，不会上传 GitHub）
#
# MT5 实盘 / 数据拉取（run.py、live_trade.py、download_full_history.py 等）
MT5_LOGIN=12345678
MT5_PASSWORD=your_password_here
MT5_SERVER=YourBroker-Demo

# 可选：times.py 的 Tushare 数据访问凭证
TUSHARE_TOKEN=your_tushare_token_here

# Windows Web → Slurm CPU Worker（第一阶段）
TRAINING_BACKEND=slurm
SLURM_REMOTE_ROOT=/hwdata/home/jinqc/Quant/AlphaMaster
SLURM_NODE_SELECTOR=D:\Desktop\codex-remote-tools\check-best-node.ps1
SLURM_REMOTE_PYTHON=/hwdata/home/jinqc/.local/bin/python3.11
SLURM_PARTITION=cpu
SLURM_QOS=normal
SLURM_CPUS_PER_TASK=12
SLURM_MEMORY=
SLURM_TIME_LIMIT=00:30:00
SLURM_COMMAND_TIMEOUT=45
SLURM_TRANSFER_TIMEOUT=900

# 仅用于冒烟；正式运行不设置时使用 model_core/config.py 的训练步数。
# SLURM_TRAIN_STEPS=20
